#!/bin/zsh
# Native CLI entry point; JSON encoding, validation, and transport live in the
# shared, tested Python helper installed alongside barkeep-cli by Homebrew.
set -euo pipefail
script_dir="${0:A:h}"
helper="$script_dir/../libexec/barkeep_mcp.py"
[[ -f "$helper" ]] || helper="$script_dir/../mcp/barkeep_mcp.py"
if [[ ! -f "$helper" ]]; then
    print -u2 -- "barkeep: cannot find command tools; reinstall barkeep-cli"
    exit 1
fi
exec /usr/bin/python3 "$helper" --cli "$@"
